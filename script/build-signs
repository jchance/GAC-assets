#!/usr/bin/env bash
# Build the membership table sign and the pick-your-art card from the
# Python sources in signs/. Writes an editable SVG, a print PDF, and a
# proof PNG for each to images/signs/, plus the Signs page share image.
#
# The SVGs ask for FatFrank (heavy weight) and RuckSack (Book, Demi, Bold) by name,
# so those fonts must be installed on this Mac through Adobe Fonts.
#
# Usage: script/build-signs
#
# Needs Google Chrome, python3, and poppler (pdftoppm, pdffonts).

set -euo pipefail

cd "$(dirname "$0")/.."

OUT="images/signs"
CHROME="${CHROME:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# Wrap one or more copies of an SVG in a letter-size print page.
# A second copy goes below the first with a dashed cut line between them.
wrap() {
  local svg="$1" copies="$2" html="$3"
  python3 -I - "$svg" "$copies" "$html" <<'PY'
import sys
svg = open(sys.argv[1]).read().split("?>", 1)[1]
copies, out = int(sys.argv[2]), sys.argv[3]
cut = '<div style="position:absolute;top:5.5in;left:0;width:8.5in;border-top:0.5pt dashed #bbb"></div>'
body = svg if copies == 1 else svg + cut + svg
open(out, "w").write(
    '<!doctype html><html><head><meta charset="utf-8"><style>'
    "@page{size:letter;margin:0}html,body{margin:0}svg{display:block}"
    "text{font-synthesis:none}</style></head><body>" + body + "</body></html>")
PY
}

print_pdf() {
  local html="$1" out="$2"
  "$CHROME" --headless=new --disable-gpu --no-pdf-header-footer \
    --virtual-time-budget=10000 --print-to-pdf="$out" "file://$html" 2>/dev/null
  # Fail if a brand font is missing (Chrome would fall back silently).
  for font in FatFrank-Heavy RuckSack; do
    if ! pdffonts "$out" | grep -q "$font"; then
      echo "error: $font is not embedded in $out. Is it installed from Adobe Fonts?" >&2
      exit 1
    fi
  done
}

echo "Building the membership table sign"
sign="$OUT/GAC Membership Table Sign"
python3 -I signs/membership-table-sign.py "$sign.svg" >/dev/null
wrap "$PWD/$sign.svg" 1 "$tmp/sign.html"
print_pdf "$tmp/sign.html" "$sign.pdf"
pdftoppm -r 100 -png -singlefile "$sign.pdf" "$sign - proof" 2>/dev/null

echo "Building the pick-your-art card"
card="$OUT/GAC Pick Your Art Card"
python3 -I signs/pick-your-art-card.py "$card.svg" >/dev/null
wrap "$PWD/$card.svg" 2 "$tmp/card.html"
print_pdf "$tmp/card.html" "$card - 2 per page.pdf"
pdftoppm -r 100 -png -singlefile -H 550 "$card - 2 per page.pdf" "$card - proof" 2>/dev/null

echo "Building the share image"
# 1200x630 link preview: the sign and the card side by side on a gray backdrop.
pdftoppm -png -singlefile -scale-to-x -1 -scale-to-y 540 "$sign.pdf" "$tmp/share-sign" 2>/dev/null
pdftoppm -png -singlefile -scale-to-x 620 -scale-to-y -1 -H 396 -W 612 -r 72 "$card - 2 per page.pdf" "$tmp/share-card" 2>/dev/null
magick "$tmp/share-card.png" -resize 620x "$tmp/share-card.png"
magick -size 1200x630 xc:'#e9ebee' \
  \( "$tmp/share-sign.png" -bordercolor '#d5d9de' -border 1 \) -geometry +60+44 -composite \
  \( "$tmp/share-card.png" -bordercolor '#d5d9de' -border 1 \) -gravity East -geometry +60+0 -composite \
  -strip "$OUT/signs-share.png"

echo "Done. Files are in $OUT/"
